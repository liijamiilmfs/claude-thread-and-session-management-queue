{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "ArtifactData|mcp__hearthbot__post_message|mcp__hearthbot__request_decision",
        "hooks": [
          { "type": "command", "command": "/opt/node24/bin/node \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.ts\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "/opt/node24/bin/node \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.ts\"", "timeout": 10 }
        ]
      }
    ]
  }
}
